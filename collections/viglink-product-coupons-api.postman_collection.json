          "name": "Product coupons by URL",
          "request": {
            "name": "Product coupons by URL",
            "description": {
              "content": "Returns verified and unverified coupon codes for a specific product URL, along with merchant information and verification status.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "product"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Site API key for the site requesting coupons.\n"
                },
                {
                  "disabled": false,
                  "key": "product_url",
                  "value": "<url>",
                  "description": "(Required) Original retailer product page URL. Must not be an affiliate or redirect URL.\n"
                },
                {
                  "disabled": false,
                  "key": "include_unverified",
                  "value": "true",
                  "description": "Whether to include unverified coupon codes after verified results. Defaults to true.\n"
                },
                {
                  "disabled": false,
                  "key": "cuid",
                  "value": "<string>",
                  "description": "Custom identifier used to associate the click with a user, page, campaign, or event.\n"
                },
                {
                  "disabled": false,
                  "key": "utm_source",
                  "value": "<string>",
                  "description": "Identifies the source of the traffic (e.g., website, newsletter, twitter)."
                },
                {
                  "disabled": false,
                  "key": "utm_medium",
                  "value": "<string>",
                  "description": "Identifies the marketing medium (e.g., email, social, banner)."
                },
                {
                  "disabled": false,
                  "key": "utm_campaign",
                  "value": "<string>",
                  "description": "Identifies the campaign name, promotion, or initiative."
                },
                {
                  "disabled": false,
                  "key": "utm_term",
                  "value": "<string>",
                  "description": "Identifies paid search keywords or targeting terms."
                },
                {
                  "disabled": false,
                  "key": "utm_content",
                  "value": "<string>",
                  "description": "Differentiates similar links or placements on the same page."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
